#!/usr/bin/env bash
# figma — standalone Figma REST API CLI (api.figma.com).
#
# A personal access token from $FIGMA_TOKEN or ~/.config/figma/token is sent as
# X-Figma-Token; each subcommand is a thin curl call whose JSON body lands on
# stdout for jq. Figma URLs are accepted anywhere a file key is, and a URL's
# node-id=1-23 is normalized to the REST form 1:23.
#
#   figma setup figd_XXXX                    # store + verify a token
#   figma file https://figma.com/design/KEY  # document JSON
#   figma screenshot URL -o frame.png        # render a node to a file
#   figma api GET /v1/files/KEY depth=2      # raw passthrough for everything else
#
# Run `figma help` for the full command list. Targets macOS system bash 3.2.
set -uo pipefail

BASE_URL=${FIGMA_BASE_URL:-https://api.figma.com}
TIMEOUT=${FIGMA_TIMEOUT:-120}
TOKEN_FILE=${FIGMA_TOKEN_FILE:-"$HOME/.config/figma/token"}
RAW=0
COMPACT=0

warn() { echo "figma: $*" >&2; }
die() { warn "$*"; exit 1; }
need() { command -v "$1" >/dev/null || die "'$1' is required but not installed"; }
need curl; need jq

TMP_BODY=$(mktemp)
TMP_ERR=$(mktemp)
trap 'rm -f "$TMP_BODY" "$TMP_ERR"' EXIT

token() {
  if [ -n "${FIGMA_TOKEN:-}" ]; then printf '%s' "$FIGMA_TOKEN"
  elif [ -r "$TOKEN_FILE" ]; then tr -d '\r\n' <"$TOKEN_FILE"
  else return 1
  fi
}

render_file() {
  if [ "$RAW" = 1 ]; then cat "$1"; printf '\n'; return; fi
  if [ "$COMPACT" = 1 ]; then jq -c . "$1" 2>/dev/null || cat "$1"
  else jq . "$1" 2>/dev/null || cat "$1"; fi
}

api_request() { # METHOD PATH [query k=v ...]; request body comes from API_BODY
  local method=$1 path=$2 tok status rc key value
  shift 2
  tok=$(token) || { warn "no token — run 'figma setup' or set FIGMA_TOKEN"; return 4; }
  [ -n "$tok" ] || { warn "empty token — run 'figma setup'"; return 4; }

  local curl_args
  curl_args=(--silent --show-error --connect-timeout 15 --max-time "$TIMEOUT"
    --request "$method" --header "X-Figma-Token: $tok" --output "$TMP_BODY"
    --write-out '%{http_code}')
  if [ "$method" = GET ]; then
    curl_args+=(--get)
    while [ $# -gt 0 ]; do
      case "$1" in
        *=*) key=${1%%=*}; value=${1#*=}; curl_args+=(--data-urlencode "$key=$value") ;;
        *) warn "query must be k=v, got '$1'"; return 1 ;;
      esac
      shift
    done
  else
    curl_args+=(--header 'Content-Type: application/json')
    [ -z "${API_BODY:-}" ] || curl_args+=(--data-binary "$API_BODY")
    [ $# -eq 0 ] || { warn "unexpected arguments after request body: $*"; return 1; }
  fi

  status=$(curl "${curl_args[@]}" "$BASE_URL$path" 2>"$TMP_ERR") && rc=0 || rc=$?
  if [ "$rc" != 0 ]; then
    cat "$TMP_ERR" >&2
    warn "network error (curl $rc)"
    return 3
  fi
  case "$status" in
    2??) render_file "$TMP_BODY" ;;
    401)
      jq -r '.message // .err // .error // empty' "$TMP_BODY" 2>/dev/null >&2 || true
      warn "authentication failed — run 'figma setup'"
      return 4 ;;
    403)
      # Figma answers 403 both for a bad token and for a gated endpoint; only the
      # former is worth sending the user back to `figma setup`.
      if [ "$path" = /v1/me ] || jq -er '((.message // .err // "") | test("token|authentic"; "i"))' "$TMP_BODY" >/dev/null 2>&1; then
        jq -r '.message // .err // .error // empty' "$TMP_BODY" 2>/dev/null >&2 || true
        warn "authentication failed — run 'figma setup'"
        return 4
      fi
      jq -r '.message // .err // .error // "HTTP 403"' "$TMP_BODY" 2>/dev/null >&2 || cat "$TMP_BODY" >&2
      warn "API request forbidden; endpoint may be plan-, scope-, or permission-gated"
      return 2 ;;
    *)
      jq -r '.message // .err // .error // empty' "$TMP_BODY" 2>/dev/null >&2 || cat "$TMP_BODY" >&2
      warn "API error HTTP $status ($method $path)"
      return 2 ;;
  esac
}

# These run inside $(...), so they report failure by return code — an exit here
# would only kill the subshell and let the caller run on with an empty value.
file_key() { # Figma URL -> file key; a bare key passes through unchanged
  local input=$1 key
  case "$input" in
    http://*|https://*)
      key=$(printf '%s' "$input" | sed -E 's#^https?://(www\.)?figma\.com/(design|file|board|proto|slides|make)/([^/?#]+).*$#\3#')
      [ "$key" != "$input" ] || { warn "could not parse a Figma file key from '$input'"; return 1; }
      printf '%s' "$key" ;;
    *) printf '%s' "$input" ;;
  esac
}

normalize_node_id() { # URL form 1-23 -> REST form 1:23
  case "$1" in *:*) printf '%s' "$1" ;; *-*) printf '%s' "$1" | sed 's/-/:/' ;; *) printf '%s' "$1" ;; esac
}

url_node_id() { # ...?node-id=1-23 -> 1:23; fails when the URL carries no node
  local input=$1 node
  case "$input" in
    *[?\&]node-id=*)
      node=$(printf '%s' "$input" | sed -E 's/.*[?&]node-id=([^&#]+).*/\1/' | sed 's/%3A/:/Ig')
      normalize_node_id "$node" ;;
    *) return 1 ;;
  esac
}

join_csv() { # node IDs -> the normalized comma list the ?ids= query wants
  local out="" value
  while [ $# -gt 0 ]; do
    value=$(normalize_node_id "$1")
    if [ -n "$out" ]; then out="$out,$value"; else out=$value; fi
    shift
  done
  printf '%s' "$out"
}

usage() {
  cat <<'EOF'
figma — Figma REST API CLI. JSON on stdout; pipe to jq.

auth:
  figma setup [TOKEN]                         store PAT (or read from stdin), verify with /v1/me
  figma me                                    current user

files:
  figma file URL|KEY [--depth N] [--geometry] [--version ID] [--branches] [--meta]
  figma nodes URL|KEY [NODE_ID ...] [--depth N] [--geometry] [--version ID]
  figma screenshot URL|KEY [NODE_ID] [-o FILE] [--format png|jpg|svg|pdf] [--scale N]
  figma comments URL|KEY
  figma comment URL|KEY TEXT [--node NODE_ID] post a comment (write)
  figma versions URL|KEY [--page URL]
  figma components URL|KEY                    published file components
  figma styles URL|KEY                        published file styles
  figma variables URL|KEY                     local variables (Enterprise only)

workspace:
  figma project files PROJECT_ID [--branches]
  figma team projects TEAM_ID
  figma team components TEAM_ID [--page-size N] [--after CURSOR|--before CURSOR]
  figma team styles TEAM_ID [--page-size N] [--after CURSOR|--before CURSOR]

escape hatch:
  figma api GET /v1/files/KEY [query=value ...]
  figma api POST /v1/files/KEY/comments [--body JSON|--body-file FILE|-]

global flags (anywhere): --raw  -c/--compact  --timeout N
env: FIGMA_TOKEN  FIGMA_TOKEN_FILE  FIGMA_BASE_URL  FIGMA_TIMEOUT
EOF
}

POSARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --raw) RAW=1; shift ;;
    -c|--compact) COMPACT=1; shift ;;
    --timeout) TIMEOUT=${2:?--timeout needs seconds}; shift 2 ;;
    *) POSARGS+=("$1"); shift ;;
  esac
done
set -- ${POSARGS[@]+"${POSARGS[@]}"}

cmd=${1:-help}
[ $# -gt 0 ] && shift

case "$cmd" in
  help|-h|--help) usage ;;
  setup)
    if [ -n "${1:-}" ]; then candidate=$1
    elif [ ! -t 0 ]; then IFS= read -r candidate
    else die "usage: figma setup TOKEN (or pipe token on stdin)"
    fi
    [ -n "$candidate" ] || die "refusing empty token"
    FIGMA_TOKEN=$candidate
    RAW=1 api_request GET /v1/me >/dev/null || exit $?
    mkdir -p "$(dirname "$TOKEN_FILE")"
    umask 077                     # so a fresh token file is never briefly world-readable
    printf '%s\n' "$candidate" >"$TOKEN_FILE"
    chmod 600 "$TOKEN_FILE"       # and an existing one is tightened too
    echo "figma: token stored in $TOKEN_FILE; ready" ;;
  me) api_request GET /v1/me ;;
  file)
    target=${1:?usage: figma file URL|KEY [flags]}; shift
    key=$(file_key "$target") || exit 1
    path="/v1/files/$key"; query=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --depth) query+=("depth=${2:?--depth needs value}"); shift 2 ;;
        --geometry) query+=("geometry=paths"); shift ;;
        --version) query+=("version=${2:?--version needs value}"); shift 2 ;;
        --branches) query+=("branch_data=true"); shift ;;
        --meta) path="/v1/files/$key/meta"; shift ;;
        *) die "unknown flag '$1'" ;;
      esac
    done
    api_request GET "$path" ${query[@]+"${query[@]}"} ;;
  nodes)
    target=${1:?usage: figma nodes URL|KEY [NODE_ID ...]}; shift
    key=$(file_key "$target") || exit 1
    ids=(); query=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --depth) query+=("depth=${2:?--depth needs value}"); shift 2 ;;
        --geometry) query+=("geometry=paths"); shift ;;
        --version) query+=("version=${2:?--version needs value}"); shift 2 ;;
        -*) die "unknown flag '$1'" ;;
        *) ids+=("$1"); shift ;;
      esac
    done
    if [ "${#ids[@]}" -eq 0 ]; then
      node=$(url_node_id "$target") || die "node ID required — pass NODE_ID, or a URL containing node-id"
      ids+=("$node")
    fi
    query+=("ids=$(join_csv "${ids[@]}")")
    api_request GET "/v1/files/$key/nodes" "${query[@]}" ;;
  screenshot)
    target=${1:?usage: figma screenshot URL|KEY [NODE_ID] [-o FILE]}; shift
    key=$(file_key "$target") || exit 1
    node=""; format=png; scale=1; output=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -o|--output) output=${2:?--output needs file}; shift 2 ;;
        --format) format=${2:?--format needs value}; shift 2 ;;
        --scale) scale=${2:?--scale needs value}; shift 2 ;;
        --node) node=$(normalize_node_id "${2:?--node needs ID}"); shift 2 ;;
        -*) die "unknown flag '$1'" ;;
        *) [ -z "$node" ] || die "only one node can be rendered"; node=$(normalize_node_id "$1"); shift ;;
      esac
    done
    if [ -z "$node" ]; then
      node=$(url_node_id "$target") || die "node ID required — pass NODE_ID, or a URL containing node-id"
    fi
    case "$format" in png|jpg|svg|pdf) ;; *) die "format must be png, jpg, svg, or pdf" ;; esac
    [ -n "$output" ] || output="figma-${node/:/-}.$format"
    [ ! -e "$output" ] || die "refusing to overwrite '$output'"
    # Render URLs are short-lived, so fetch the image in the same breath.
    render=$(RAW=1 api_request GET "/v1/images/$key" "ids=$node" "format=$format" "scale=$scale") || exit $?
    image_url=$(jq -er --arg id "$node" '.images[$id] // empty' <<<"$render") || die "render returned no image URL for node $node"
    status=$(curl --silent --show-error --location --connect-timeout 15 --max-time "$TIMEOUT" --output "$TMP_BODY" --write-out '%{http_code}' "$image_url" 2>"$TMP_ERR") && rc=0 || rc=$?
    if [ "$rc" != 0 ]; then cat "$TMP_ERR" >&2; warn "image download network error (curl $rc)"; exit 3; fi
    case "$status" in 2??) ;; *) warn "image download failed HTTP $status"; exit 2 ;; esac
    cat "$TMP_BODY" >"$output"   # not mv: keeps the file at the caller's umask, not mktemp's 0600
    printf '%s\n' "$output" ;;
  comments)
    target=${1:?usage: figma comments URL|KEY}
    key=$(file_key "$target") || exit 1
    api_request GET "/v1/files/$key/comments" ;;
  comment)
    target=${1:?usage: figma comment URL|KEY TEXT [--node ID]}; text=${2:?comment text required}; shift 2
    key=$(file_key "$target") || exit 1
    node=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --node) node=$(normalize_node_id "${2:?--node needs ID}"); shift 2 ;;
        *) die "unknown flag '$1'" ;;
      esac
    done
    if [ -z "$node" ]; then node=$(url_node_id "$target") || node=""; fi
    # An anchored comment needs a full FrameOffset; unanchored ones land on the file.
    if [ -n "$node" ]; then
      API_BODY=$(jq -cn --arg message "$text" --arg node_id "$node" \
        '{message:$message,client_meta:{node_id:$node_id,node_offset:{x:0,y:0}}}')
    else
      API_BODY=$(jq -cn --arg message "$text" '{message:$message}')
    fi
    api_request POST "/v1/files/$key/comments" ;;
  versions)
    target=${1:?usage: figma versions URL|KEY [--page URL]}; shift
    key=$(file_key "$target") || exit 1
    path="/v1/files/$key/versions"
    if [ "${1:-}" = --page ]; then
      page=${2:?--page needs URL}
      case "$page" in "$BASE_URL"/*) path=${page#"$BASE_URL"} ;; *) die "--page wants a pagination URL from a previous response" ;; esac
    fi
    api_request GET "$path" ;;
  components|styles|variables)
    target=${1:?usage: figma $cmd URL|KEY}
    key=$(file_key "$target") || exit 1
    if [ "$cmd" = variables ]; then path="/v1/files/$key/variables/local"; else path="/v1/files/$key/$cmd"; fi
    api_request GET "$path" ;;
  project)
    sub=${1:-}; [ $# -gt 0 ] && shift
    case "$sub" in
      files)
        id=${1:?usage: figma project files PROJECT_ID}; shift
        query=()
        while [ $# -gt 0 ]; do
          case "$1" in
            --branches) query+=("branch_data=true"); shift ;;
            *) die "unknown flag '$1'" ;;
          esac
        done
        api_request GET "/v1/projects/$id/files" ${query[@]+"${query[@]}"} ;;
      *) die "usage: figma project files PROJECT_ID [--branches]" ;;
    esac ;;
  team)
    sub=${1:-}; [ $# -gt 0 ] && shift
    id=${1:?usage: figma team projects|components|styles TEAM_ID}; shift
    case "$sub" in
      projects) api_request GET "/v1/teams/$id/projects" ;;
      components|styles)
        query=()
        while [ $# -gt 0 ]; do
          case "$1" in
            --page-size) query+=("page_size=${2:?--page-size needs a value}"); shift 2 ;;
            --after)     query+=("after=${2:?--after needs a cursor}"); shift 2 ;;
            --before)    query+=("before=${2:?--before needs a cursor}"); shift 2 ;;
            *) die "unknown flag '$1'" ;;
          esac
        done
        api_request GET "/v1/teams/$id/$sub" ${query[@]+"${query[@]}"} ;;
      *) die "usage: figma team projects|components|styles TEAM_ID" ;;
    esac ;;
  api)
    method=$(printf '%s' "${1:?usage: figma api METHOD PATH [query k=v ...]}" | tr '[:lower:]' '[:upper:]')
    path=${2:?path required}; shift 2; API_BODY=""
    case "$method" in
      GET) api_request GET "$path" "$@" ;;
      POST|PUT|PATCH|DELETE)
        while [ $# -gt 0 ]; do
          case "$1" in
            --body) API_BODY=${2:?--body needs JSON}; shift 2 ;;
            --body-file)
              if [ "${2:?--body-file needs a file}" = - ]; then API_BODY=$(cat); else API_BODY=$(<"$2"); fi
              shift 2 ;;
            -) API_BODY=$(cat); shift ;;
            *) die "unknown body argument '$1'" ;;
          esac
        done
        if [ -z "$API_BODY" ] && [ "$method" != DELETE ]; then API_BODY='{}'; fi
        [ -z "$API_BODY" ] || jq -e . >/dev/null 2>&1 <<<"$API_BODY" || die "request body is not valid JSON"
        api_request "$method" "$path" ;;
      *) die "unsupported method '$method'" ;;
    esac ;;
  *) die "unknown command '$cmd' — run 'figma help'" ;;
esac
